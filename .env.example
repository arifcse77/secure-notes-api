NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/secure_notes
JWT_SECRET=replace_with_a_random_secret_at_least_32_characters
JWT_EXPIRES_IN=1h
BCRYPT_ROUNDS=12
CORS_ORIGIN=http://localhost:3000

